{
  // Cloudflare settings: serve the built website in site/ as static pages,
  // with a small worker (worker/index.js) answering /api/ for the Well.
  "name": "relational-river-website",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // Once a week, delete Well offerings older than three years.
  "triggers": { "crons": ["17 4 * * 1"] }
  // To keep offerings, create a D1 database and add it here, for example:
  // "d1_databases": [{ "binding": "WELL_DB", "database_name": "relational-river-well", "database_id": "<id>" }]
}
